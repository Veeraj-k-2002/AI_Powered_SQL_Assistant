# ── Groq API (free tier) ───────────────────────────────────
# Get your free key at https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here

# ── App's own PostgreSQL database ──────────────────────────
# This stores database configs and chat history
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/sql_chatbot

# ── App settings ───────────────────────────────────────────
APP_NAME="AI SQL Chatbot"
APP_ENV=development          # development | production
SECRET_KEY=changeme_use_openssl_rand_hex_32_here
# Required in production. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATABASE_ENCRYPTION_KEY=
BACKEND_URL=http://localhost:8000

# ── Query safeguards ──────────────────────────────────────
MAX_QUERY_ROWS=500
QUERY_TIMEOUT_MS=15000
QUERY_CACHE_TTL_SECONDS=60
QUERY_CACHE_MAX_ENTRIES=200

# ── Optional: Redis ────────────────────────────────────────
# REDIS_URL=redis://localhost:6379/0
